{
  "name": "bar-karaoke-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend del sistema de inventario y mesas para el bar karaoke",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "socket:test": "node scripts/socket-test-client.js",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:logs": "pm2 logs posada-del-palomo",
    "backup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/backup-db.ps1"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.19.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.14.15",
    "@types/swagger-ui-express": "^4.1.6",
    "prisma": "^5.19.1",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4"
  }
}
