generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RolUsuario {
  ADMIN
  MESERO

  @@map("rol_usuario")
}

enum UnidadMedida {
  ML
  UNIDAD

  @@map("unidad_medida")
}

enum TipoMovimiento {
  ENTRADA
  SALIDA
  AJUSTE

  @@map("tipo_movimiento")
}

enum EstadoMesa {
  LIBRE
  OCUPADA
  POR_COBRAR

  @@map("estado_mesa")
}

enum EstadoCuenta {
  ABIERTA
  CERRADA

  @@map("estado_cuenta")
}

enum MetodoPago {
  EFECTIVO
  TARJETA
  TRANSFERENCIA

  @@map("metodo_pago")
}

enum CategoriaGasto {
  SUELDOS
  COMIDA_PERSONAL
  INSUMOS
  OTRO

  @@map("categoria_gasto")
}

model Usuario {
  id           Int        @id @default(autoincrement())
  nombre       String
  usuario      String     @unique
  passwordHash String     @map("password_hash")
  rol          RolUsuario
  activo       Boolean    @default(true)
  createdAt    DateTime   @default(now()) @map("created_at")

  movimientosInventario MovimientoInventario[]
  cuentas               Cuenta[]
  gastos                Gasto[]
  cierresCaja           CierreDeCaja[]

  @@map("usuarios")
}

model Categoria {
  id     Int    @id @default(autoincrement())
  nombre String @unique

  insumos        Insumo[]
  productosVenta ProductoVenta[]

  @@map("categorias")
}

model Insumo {
  id          Int          @id @default(autoincrement())
  nombre      String
  categoriaId Int          @map("categoria_id")
  unidad      UnidadMedida
  costo       Decimal      @db.Decimal(10, 2)
  stockActual Decimal      @default(0) @db.Decimal(10, 2) @map("stock_actual")
  stockMinimo Decimal      @default(0) @db.Decimal(10, 2) @map("stock_minimo")
  createdAt   DateTime     @default(now()) @map("created_at")

  categoria   Categoria              @relation(fields: [categoriaId], references: [id])
  recetaItems RecetaItem[]
  movimientos MovimientoInventario[]

  @@map("insumos")
}

model ProductoVenta {
  id                 Int      @id @default(autoincrement())
  nombre             String
  categoriaId        Int      @map("categoria_id")
  precioVenta        Decimal  @db.Decimal(10, 2) @map("precio_venta")
  unidadesPorEntrega Int      @default(1) @map("unidades_por_entrega")
  createdAt          DateTime @default(now()) @map("created_at")

  categoria    Categoria      @relation(fields: [categoriaId], references: [id])
  recetaItems  RecetaItem[]
  itemsConsumo ItemConsumo[]

  @@map("productos_venta")
}

model RecetaItem {
  id              Int     @id @default(autoincrement())
  productoVentaId Int     @map("producto_venta_id")
  insumoId        Int     @map("insumo_id")
  cantidad        Decimal @db.Decimal(10, 2)

  productoVenta ProductoVenta @relation(fields: [productoVentaId], references: [id], onDelete: Cascade)
  insumo        Insumo        @relation(fields: [insumoId], references: [id])

  @@unique([productoVentaId, insumoId])
  @@map("receta_items")
}

model MovimientoInventario {
  id        Int            @id @default(autoincrement())
  insumoId  Int            @map("insumo_id")
  tipo      TipoMovimiento
  cantidad  Decimal        @db.Decimal(10, 2)
  costo     Decimal?       @db.Decimal(10, 2)
  proveedor String?
  motivo    String?
  fecha     DateTime       @default(now())
  usuarioId Int            @map("usuario_id")

  insumo  Insumo  @relation(fields: [insumoId], references: [id])
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@map("movimientos_inventario")
}

model Mesa {
  id     Int        @id @default(autoincrement())
  numero Int        @unique
  nombre String?
  estado EstadoMesa @default(LIBRE)
  activo Boolean    @default(true)

  cuentas Cuenta[]

  @@map("mesas")
}

model Cuenta {
  id            Int          @id @default(autoincrement())
  mesaId        Int          @map("mesa_id")
  usuarioId     Int?         @map("usuario_id")
  fechaApertura DateTime     @default(now()) @map("fecha_apertura")
  fechaCierre   DateTime?    @map("fecha_cierre")
  estado        EstadoCuenta @default(ABIERTA)
  total         Decimal      @default(0) @db.Decimal(10, 2)
  descuento     Decimal      @default(0) @db.Decimal(10, 2)
  metodoPago    MetodoPago?  @map("metodo_pago")

  mesa         Mesa          @relation(fields: [mesaId], references: [id])
  usuario      Usuario?      @relation(fields: [usuarioId], references: [id])
  itemsConsumo ItemConsumo[]
  pagos        Pago[]

  @@map("cuentas")
}

model ItemConsumo {
  id                 Int     @id @default(autoincrement())
  cuentaId           Int     @map("cuenta_id")
  productoVentaId    Int     @map("producto_venta_id")
  cantidad           Int
  cantidadEntregada  Int     @default(0) @map("cantidad_entregada")
  cantidadPagada     Int     @default(0) @map("cantidad_pagada")
  precioUnitario     Decimal @db.Decimal(10, 2) @map("precio_unitario")
  subtotal           Decimal @db.Decimal(10, 2)

  cuenta        Cuenta        @relation(fields: [cuentaId], references: [id], onDelete: Cascade)
  productoVenta ProductoVenta @relation(fields: [productoVentaId], references: [id])
  pagos         Pago[]

  @@map("items_consumo")
}

// Registra cada pago individual (uno por unidad marcada "+1 pagado", o uno
// por linea del pago mixto al cerrar la cuenta) con su metodo. cuentaId es
// la fuente de verdad para reportes de caja; itemConsumoId es opcional y se
// pone en null si el item se elimina, para no perder el registro del dinero.
model Pago {
  id              Int        @id @default(autoincrement())
  cuentaId        Int        @map("cuenta_id")
  itemConsumoId   Int?       @map("item_consumo_id")
  monto           Decimal    @db.Decimal(10, 2)
  metodoPago      MetodoPago @map("metodo_pago")
  fecha           DateTime   @default(now())

  cuenta      Cuenta       @relation(fields: [cuentaId], references: [id], onDelete: Cascade)
  itemConsumo ItemConsumo? @relation(fields: [itemConsumoId], references: [id], onDelete: SetNull)

  @@map("pagos")
}

// Gasto operativo del dia (sueldos, comida del personal, insumos comprados
// de urgencia, etc.), independiente de las compras de inventario que ya se
// registran como MovimientoInventario. metodoPago determina si afecta el
// cuadre de efectivo en CierreDeCaja: solo los gastos en EFECTIVO se
// descuentan del efectivo que deberia haber en caja.
model Gasto {
  id         Int            @id @default(autoincrement())
  fecha      DateTime       @default(now())
  concepto   String
  categoria  CategoriaGasto @default(OTRO)
  monto      Decimal        @db.Decimal(10, 2)
  metodoPago MetodoPago     @default(EFECTIVO) @map("metodo_pago")
  usuarioId  Int?           @map("usuario_id")
  createdAt  DateTime       @default(now()) @map("created_at")

  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@map("gastos")
}

// Cuadre de caja de una jornada (una fila por dia calendario). montoInicial
// normalmente es el montoContado del cierre del dia anterior (el sistema lo
// "recuerda" para arrancar el dia siguiente con ese efectivo), pero se puede
// pasar manualmente al crear el cierre. montoEsperado = montoInicial +
// ventasEfectivo - gastosEfectivo; diferencia = montoContado - montoEsperado
// (positivo = sobra efectivo, negativo = falta).
model CierreDeCaja {
  id             Int      @id @default(autoincrement())
  fecha          DateTime @unique @db.Date
  montoInicial   Decimal  @db.Decimal(10, 2) @map("monto_inicial")
  ventasEfectivo Decimal  @db.Decimal(10, 2) @map("ventas_efectivo")
  gastosEfectivo Decimal  @db.Decimal(10, 2) @map("gastos_efectivo")
  montoEsperado  Decimal  @db.Decimal(10, 2) @map("monto_esperado")
  montoContado   Decimal  @db.Decimal(10, 2) @map("monto_contado")
  diferencia     Decimal  @db.Decimal(10, 2)
  notas          String?
  usuarioId      Int?     @map("usuario_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@map("cierres_caja")
}
